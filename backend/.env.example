# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=NeuroOps AI
APP_VERSION=1.0.0
DEBUG=true

# ─── Server ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_HISTORY_LIMIT=100
METRICS_COLLECTION_INTERVAL=3

# ─── AI / Anomaly Detection ───────────────────────────────────────────────────
ANOMALY_CONTAMINATION=0.1
ANOMALY_MIN_SAMPLES=20

# ─── Alert Thresholds ─────────────────────────────────────────────────────────
ALERT_CPU_THRESHOLD=85.0
ALERT_MEMORY_THRESHOLD=90.0
ALERT_DISK_THRESHOLD=95.0

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
