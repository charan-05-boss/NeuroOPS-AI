# ─── Env ──────────────────────────────────────────────────────────────────────
# The base URL of the FastAPI backend API
# In production (Netlify), set this to your Render backend URL (e.g., https://neuroops-backend.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# The WebSocket URL for real-time monitoring and anomaly detection
# In production, set this to wss://neuroops-backend.onrender.com/ws
VITE_WS_URL=ws://localhost:8000/ws

VITE_POLL_INTERVAL_MS=3000
VITE_APP_NAME=NeuroOps AI
